# Конфигурация для Docker Compose
# Скопируйте этот файл в .env и настройте параметры

# ==========================================
# Настройки ESP32 устройства
# ==========================================

# IP адрес ESP32 в вашей локальной сети
# Пример: 192.168.1.100
ESP32_IP=192.168.1.100

# Порт API ESP32 (обычно 80)
ESP32_API_PORT=80

# Порт видеопотока ESP32 (обычно 81)
ESP32_STREAM_PORT=81

# ==========================================
# Настройки домена и SSL
# ==========================================

# Доменное имя для доступа к устройству
# Пример: robot.example.com или myrobot.local
# ВАЖНО: Для Let's Encrypt сертификатов домен должен быть публично доступен
DOMAIN_NAME=robot.example.com

# Email для уведомлений Let's Encrypt (опционально)
# Используется для получения уведомлений об истечении сертификатов
LETSENCRYPT_EMAIL=admin@example.com

# Режим получения сертификатов Let's Encrypt
# staging - для тестирования (не выдает валидные сертификаты, но нет лимитов)
# production - для продакшена (валидные сертификаты, есть лимиты на количество запросов)
# selfsigned - самоподписанный сертификат (для локальной сети без интернета)
CERT_MODE=production

# ==========================================
# Дополнительные настройки
# ==========================================

# Часовой пояс для контейнеров
TZ=Europe/Moscow

# Уровень логирования nginx (debug, info, notice, warn, error, crit, alert, emerg)
NGINX_LOG_LEVEL=warn

# Имя устройства (используется для логов и идентификации)
DEVICE_NAME=robot1
